{
  "name": "stocks",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --watchAll",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "dev": "expo run:ios --device",
    "release": "npx expo run:ios --device 00008140-001504DE1E93801C --configuration Release",
    "release:a": "npx expo run:android --device --variant=release",
    "preview:p:a": "eas build --platform android --profile preview --local",
    "release:p:a": "eas build --platform android --profile production --local",
    "bump-version": "node scripts/bump-version.js",
    "push-update:android": "eas update --platform android",
    "sign:ios": "xcodebuild -workspace ios/Portfolio.xcworkspace -scheme Portfolio -allowProvisioningUpdates"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.1.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "expo": "^57.0.0",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-local-authentication": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.5",
    "expo-updates": "~57.0.8",
    "expo-web-browser": "~57.0.1",
    "i18next": "^25.1.1",
    "lucide-react-native": "^0.511.0",
    "nativewind": "^4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.5.1",
    "react-native": "0.86.0",
    "react-native-collapsible": "^1.6.2",
    "react-native-dialog": "^9.3.0",
    "react-native-flip-card": "^3.5.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-picker-select": "^9.3.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-toast-message": "^2.2.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^3",
    "uuid": "^11.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/config-plugins": "^57.0.5",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.0",
    "@types/react-native-flip-card": "^3.5.7",
    "@types/react-test-renderer": "^18.3.0",
    "expo-mcp": "~0.2.1",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.0"
  },
  "private": true
}
